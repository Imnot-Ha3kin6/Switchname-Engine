+	function prepareLegacyDrawMatrix(matrix:FlxMatrix, camera:FlxCamera):Void
+	{
+		// old renderer: limb * instance (stage) matrix, then -origin, scale, skew, +position
+		final m = library.matrix;
+		matrix.concat(m);
+		matrix.translate(timeline._bounds.x * m.a, timeline._bounds.y * m.d);
+
+		matrix.translate(-legacyOrigin.x, -legacyOrigin.y);
+
+		// animation offsets and rotation behave like the regular path (mods rely on both)
+		if (frameOffsetAngle != null && frameOffsetAngle != angle)
+		{
+			var angleOff = (frameOffsetAngle - angle) * FlxAngle.TO_RAD;
+			var cos = Math.cos(angleOff);
+			var sin = Math.sin(angleOff);
+			matrix.rotateWithTrig(cos, -sin);
+			matrix.translate(-frameOffset.x, -frameOffset.y);
+			matrix.rotateWithTrig(cos, sin);
+		}
+		else
+			matrix.translate(-frameOffset.x, -frameOffset.y);
+
+		matrix.scale(scale.x, scale.y);
+
+		if (matrixExposed) matrix.concat(transformMatrix);
+		else
+		{
+			if (angle != 0)
+			{
+				updateTrig();
+				matrix.rotateWithTrig(_cosAngle, _sinAngle);
+			}
+			if (skew.x != 0 || skew.y != 0)
+			{
+				updateSkew();
+				matrix.concat(_skewMatrix);
+			}
+		}
+
+		getScreenPosition(_point, camera).subtractPoint(offset).add(legacyOrigin.x, legacyOrigin.y);
+		matrix.translate(_point.x, _point.y);
+
+		if (isPixelPerfectRender(camera))
+		{
+			matrix.tx = Math.floor(matrix.tx);
+			matrix.ty = Math.floor(matrix.ty);
+		}
+
+		doAdditionalMatrixStuff(_matrix, camera);
+	}
+
 	var stageBg:StageBG;
 
 	function drawStage(camera:FlxCamera):Void
