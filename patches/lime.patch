+++ b/templates/switch/MakeFileNRO
@@ -0,0 +1,219 @@
+# File generated by Lime-NX
+# MakefileNRO version: 1.0.0
+
+#---------------------------------------------------------------------------------
+.SUFFIXES:
+#---------------------------------------------------------------------------------
+
+ifeq ($(strip $(DEVKITPRO)),)
+$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
+endif
+
+TOPDIR ?= $(CURDIR)
+include $(DEVKITPRO)/libnx/switch_rules
+
+
+TARGET		:=	[LIME_PROJECT_FILENAME]
+BUILD		:=	build
+SOURCES		:=	[LIME_MAIN_SRC_DIR]
+DATA		:=	data
+INCLUDES	:=	[LIME_MAIN_SRC_DIR]/include
+ROMFS		:=	[LIME_APPLICATION_DIR]
+
+APP_TITLE     := [LIME_PROJECT_TITLE]
+APP_AUTHOR    := [LIME_PROJECT_AUTHOR]
+# CNE_APP_VERSION (set by the project) overrides the version shown in the homebrew menu
+APP_VERSION   := $(if $(CNE_APP_VERSION),$(CNE_APP_VERSION),[LIME_PROJECT_VERSION])
+
+HAXE_LIBMAIN := [HAXE_MAIN_LIB]
+HXCPP_PATH := `haxelib path hxcpp | head -n 1`
+
+#---------------------------------------------------------------------------------
+# options for code generation
+#---------------------------------------------------------------------------------
+ARCH	:=	-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
+
+CFLAGS	:=	-g -Wall -O2 -ffunction-sections \
+			$(ARCH) $(DEFINES)
+
+CFLAGS	+=	$(INCLUDE) -D__SWITCH__ -I"$(HXCPP_PATH)/include/" -DENABLE_NXLINK -DHX_NX
+
+CXXFLAGS	:= $(CFLAGS) -fexceptions
+
+ASFLAGS	:=	-g $(ARCH)
+LDFLAGS	=	-specs=$(DEVKITPRO)/libnx/switch.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)
+
+# GL/EGL provider: Mesa by default; the deko3d build sets CNE_GL_LIBS to dkgl + uam + deko3d
+CNE_GL_LIBS ?= -lglad -lEGL -lglapi -ldrm_nouveau
+
+# Librerías base
+LIBS    := -Wl,--start-group -llime $(HAXE_LIBMAIN) -lopenal -lSDL3 -lstdc++ -Wl,--end-group \
+           -lopusfile -lopus -lmpg123 -lvorbisidec -lmodplug \
+           -lvorbisfile -lvorbis -logg \
+           -lavformat -lavcodec -lswscale -lswresample -lavutil -ldav1d \
+           $(CNE_GL_LIBS) -lharfbuzz -lfreetype \
+           -lpthread -lpng -ljpeg -lwebp -lstdc++ -lm -lz -lbz2 -lnx
+
+LIBS += [ADDITIONAL_LIBS]
+
+#---------------------------------------------------------------------------------
+# list of directories containing libraries, this must be the top level containing
+# include and lib
+#---------------------------------------------------------------------------------
+# CNE_OPENAL_DIR / CNE_SDL3_DIR: folders (with include/ and lib/) of the OpenAL Soft and SDL3 Switch builds
+LIBDIRS	:= $(CNE_OPENAL_DIR) $(PORTLIBS) $(LIBNX) [LIME_MAIN_DIR] $(CNE_SDL3_DIR)
+
+#---------------------------------------------------------------------------------
+# no real need to edit anything past this point unless you need to add additional
+# rules for different file extensions
+#---------------------------------------------------------------------------------
+ifneq ($(BUILD),$(notdir $(CURDIR)))
+#---------------------------------------------------------------------------------
+
+export OUTPUT   := [OUT_DIR]/$(TARGET)
+export TOPDIR	:=	$(CURDIR)
+export SWITCH_ASSETS_DIR := [SWITCH_ASSETS_DIR]
+
+export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) \
+			$(foreach dir,$(DATA),$(CURDIR)/$(dir))
+
+export DEPSDIR	:=	$(CURDIR)/$(BUILD)
+
+CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
+CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
+SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
+BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))
+
+#---------------------------------------------------------------------------------
+# use CXX for linking C++ projects, CC for standard C
+#---------------------------------------------------------------------------------
+ifeq ($(strip $(CPPFILES)),)
+#---------------------------------------------------------------------------------
+	export LD	:=	$(CC)
+#---------------------------------------------------------------------------------
+else
+#---------------------------------------------------------------------------------
+	export LD	:=	$(CXX)
+#---------------------------------------------------------------------------------
+endif
+#---------------------------------------------------------------------------------
+
+export OFILES_BIN	:=	$(addsuffix .o,$(BINFILES))
+export OFILES_SRC	:=	$(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)
+export OFILES   	:=  $(OFILES_BIN) $(OFILES_SRC)
+export HFILES_BIN	:=	$(addsuffix .h,$(subst .,_,$(BINFILES)))
+
+export INCLUDE	:=	$(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
+			$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
+			-I$(CURDIR)/$(BUILD)
+
+export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib)
+
+ifeq ($(strip $(CONFIG_JSON)),)
+	jsons := $(wildcard *.json)
+	ifneq (,$(findstring $(TARGET).json,$(jsons)))
+		export APP_JSON := $(TOPDIR)/$(TARGET).json
+	else
+		ifneq (,$(findstring config.json,$(jsons)))
+			export APP_JSON := $(TOPDIR)/config.json
+		endif
+	endif
+else
+	export APP_JSON := $(TOPDIR)/$(CONFIG_JSON)
+endif
+
+ifeq ($(strip $(ICON)),)
+	outdir := $(SWITCH_ASSETS_DIR)/
+	
+	ifneq ($(strip $(wildcard $(outdir)$(TARGET).jpg)),)
+		export APP_ICON := $(outdir)$(TARGET).jpg
+	else ifneq ($(strip $(wildcard $(outdir)icon.jpg)),)
+		export APP_ICON := $(outdir)icon.jpg
+	endif
+else
+	export APP_ICON := $(TOPDIR)/$(ICON)
+endif
+
+ifeq ($(strip $(NO_ICON)),)
+	export NROFLAGS += --icon=$(APP_ICON)
+endif
+
+ifeq ($(strip $(NO_NACP)),)
+	export NROFLAGS += --nacp=[OUT_DIR]/$(TARGET).nacp
+endif
+
+ifneq ($(APP_TITLEID),)
+	export NACPFLAGS += --titleid=$(APP_TITLEID)
+endif
+
+ifneq ($(ROMFS),)
+	export NROFLAGS += --romfsdir=$(ROMFS)
+endif
+
+.PHONY: $(BUILD) clean all
+
+#---------------------------------------------------------------------------------
+all: $(BUILD)
+
+$(BUILD):
+	@[ -d $@ ] || mkdir -p $@
+	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile
+
+#---------------------------------------------------------------------------------
+clean:
+	@echo clean ...
+ifeq ($(strip $(APP_JSON)),)
+	@rm -fr $(BUILD) $(TARGET).nro $(TARGET).nacp $(TARGET).elf
+else
+	@rm -fr $(BUILD) $(TARGET).nsp $(TARGET).nso $(TARGET).npdm $(TARGET).elf
+endif
+
+
+#---------------------------------------------------------------------------------
+else
+.PHONY:	all
+
+DEPENDS_TMP  := $(OFILES:.o=.d)
+DEPENDS      := $(filter-out ../$(HAXE_LIBMAIN),$(DEPENDS_TMP))
+
+
+#---------------------------------------------------------------------------------
+# main targets
+#---------------------------------------------------------------------------------
+ifeq ($(strip $(APP_JSON)),)
+
+all	:	$(OUTPUT).nro
+
+ifeq ($(strip $(NO_NACP)),)
+$(OUTPUT).nro	:	$(OUTPUT).elf $(OUTPUT).nacp
+else
+$(OUTPUT).nro	:	$(OUTPUT).elf
+endif
+
+else
+
+all	:	$(OUTPUT).nsp
+
+$(OUTPUT).nsp	:	$(OUTPUT).nso $(OUTPUT).npdm
+
+$(OUTPUT).nso	:	$(OUTPUT).elf
+
+endif
+
+$(OUTPUT).elf	:	$(OFILES) $(HAXE_LIBMAIN)
+
+$(OFILES_SRC)	: $(HFILES_BIN)
+
+#---------------------------------------------------------------------------------
+# you need a rule like this for each extension you use as binary data
+#---------------------------------------------------------------------------------
+%.bin.o	%_bin.h :	%.bin
+#---------------------------------------------------------------------------------
+	@echo $(notdir $<)
+	@$(bin2o)
+
+-include $(DEPENDS)
+
+#---------------------------------------------------------------------------------------
+endif
