diff --git a/src/openfl/CneBootLog.hx b/src/openfl/CneBootLog.hx
new file mode 100644
index 000000000..0a8af1a3c
--- /dev/null
+++ b/src/openfl/CneBootLog.hx
@@ -0,0 +1,53 @@
+package openfl;
+
+// Temporary Switch diagnostics.
+#if switch
+@:cppFileCode('extern "C" void cne_mem_info(unsigned long long *used, unsigned long long *total);')
+#end
+class CneBootLog
+{
+	static var counts:Map<String, Int> = new Map();
+
+	public static function log(tag:String, ?limit:Int = 2):Void
+	{
+		#if switch
+		var c = counts.exists(tag) ? counts.get(tag) : 0;
+		if (c >= limit) return;
+		counts.set(tag, c + 1);
+		try
+		{
+			var out = sys.io.File.append("sdmc:/switch/cne-port-boot.log", false);
+			out.writeString("haxe " + tag + "\n");
+			out.close();
+		}
+		catch (e:Dynamic) {}
+		#end
+	}
+
+	/** "used/total MB" for this process on Switch. */
+	public static function mem():String
+	{
+		#if switch
+		var used:Float = 0, total:Float = 0;
+		untyped __cpp__("unsigned long long u = 0, t = 0; cne_mem_info(&u, &t); {0} = (double)u; {1} = (double)t", used, total);
+		return Std.int(used / 1048576) + "/" + Std.int(total / 1048576) + " MB";
+		#else
+		return "n/a";
+		#end
+	}
+
+	/** Append one line to sdmc:/switch/cne-trace.log (no rate limit). */
+	public static function trace(msg:String):Void
+	{
+		#if switch
+		try
+		{
+			var out = sys.io.File.append("sdmc:/switch/cne-trace.log", false);
+			out.writeString(msg + "
+");
+			out.close();
+		}
+		catch (e:Dynamic) {}
+		#end
+	}
+}
