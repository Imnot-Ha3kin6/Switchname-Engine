+bool String::__StartsWith(const String &inValue) const
+{
+   if (!__s) return false;
+   if (!inValue.__s) return true;
+   if (inValue.length > length) return false;
+   if (inValue.length == 0) return true;
+   if (isUTF16Encoded() && inValue.isUTF16Encoded())
+      return memcmp(__w, inValue.__w, inValue.length * sizeof(char16_t)) == 0;
+   if (isUTF16Encoded() || inValue.isUTF16Encoded())
+      return isUTF16Encoded() ? StrMatch(__w, inValue.__s, inValue.length)
+                              : StrMatch(inValue.__w, __s, inValue.length);
+   return memcmp(__s, inValue.__s, inValue.length) == 0;
+}
+
+bool String::__EndsWith(const String &inValue) const
+{
+   if (!__s) return false;
+   if (!inValue.__s) return true;
+   if (inValue.length > length) return false;
+   if (inValue.length == 0) return true;
+   int offset = length - inValue.length;
+   if (isUTF16Encoded() && inValue.isUTF16Encoded())
+      return memcmp(__w + offset, inValue.__w, inValue.length * sizeof(char16_t)) == 0;
+   if (isUTF16Encoded() || inValue.isUTF16Encoded())
+      return isUTF16Encoded() ? StrMatch(__w + offset, inValue.__s, inValue.length)
+                              : StrMatch(inValue.__w, __s + offset, inValue.length);
+   return memcmp(__s + offset, inValue.__s, inValue.length) == 0;
+}
+
